#!/usr/bin/env bash
# Launch the Treecataje companion GUI (PySide6) from the app menu.
# Auto-detects the device serial port (it drifts between ttyACM0/ttyACM1).
set -euo pipefail

HOST="/home/derunix/code/Treecataje/host"
PY="$HOST/.venv/bin/python"

# Pick the ttyACM that answers the companion HELLO; fall back to first present.
detect_port() {
    local p
    for p in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyACM2 /dev/ttyACM3; do
        [ -e "$p" ] || continue
        if timeout -s KILL 4 "$PY" - "$p" <<'PYEOF' 2>/dev/null
import sys
sys.path.insert(0, "/home/derunix/code/Treecataje/host")
from companion_proto import Companion
c = Companion(sys.argv[1])
ok = c.hello("", timeout=1.5).get("ok")
c.close()
sys.exit(0 if ok else 1)
PYEOF
        then echo "$p"; return; fi
    done
    for p in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyACM2 /dev/ttyACM3; do [ -e "$p" ] && { echo "$p"; return; }; done
    echo /dev/ttyACM0
}

PORT="${COMPANION_PORT:-$(detect_port 2>/dev/null)}"
cd "$HOST"
exec "$PY" gui.py --port "$PORT" "$@"
